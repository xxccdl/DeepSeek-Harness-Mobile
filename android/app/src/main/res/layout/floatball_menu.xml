<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="190dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/fb_menu_bg"
    android:elevation="8dp"
    android:padding="12dp">

    <TextView
        android:id="@+id/fbMenuTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DeepSeek Harness"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingBottom="6dp" />

    <TextView
        android:id="@+id/fbMenuStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="dsh 服务：…\n手机控制：…"
        android:textColor="#C9D3E0"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp"
        android:paddingBottom="10dp" />

    <TextView
        android:id="@+id/fbMenuOpen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:text="打开应用"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:background="?android:attr/selectableItemBackground" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#33FFFFFF" />

    <TextView
        android:id="@+id/fbMenuClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="9dp"
        android:paddingBottom="4dp"
        android:text="关闭悬浮球"
        android:textColor="#FF6B6B"
        android:textSize="13sp"
        android:background="?android:attr/selectableItemBackground" />
</LinearLayout>
